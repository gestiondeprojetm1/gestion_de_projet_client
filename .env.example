# Modèle de configuration locale : copier en .env (cp .env.example .env).
# Valeurs FACTICES, à usage local uniquement. Ne jamais versionner le fichier .env.
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=app_db

# Optionnel : version affichée dans /health en local
APP_VERSION=dev
GIT_SHA=local
